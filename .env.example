# Variables de entorno — copiar a .env.local y completar.
# NUNCA subir .env.local al repositorio.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingesta / workers ---
# Secreto para invocar endpoints de ingesta por cron.
INGESTION_CRON_SECRET=
# Zona horaria de referencia para programaciones.
INGESTION_TIMEZONE=America/Santo_Domingo

# --- IA (arquitectura independiente del proveedor) ---
AI_PROVIDER=anthropic
# Clave de la API de Anthropic (solo .env.local; nunca en el repo ni en el chat).
AI_API_KEY=
AI_MODEL_EXTRACTION=
# Modelo del agente de extracción de noticias (Agente 2). Vacío = AI_MODEL_ANALYSIS o claude-sonnet-5-5.
# Modelo del análisis de noticias. Vacío = claude-sonnet-5-5.
AI_MODEL_ANALYSIS=
# Modelo de las notas de inteligencia multi-fuente. Vacío = AI_MODEL_ANALYSIS o claude-sonnet-5-5.
AI_MODEL_BRIEF=
# Límite mensual de costo en USD para cortar el pipeline si se excede.
AI_MONTHLY_BUDGET_USD=

# --- Observabilidad ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Entorno ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contacto institucional para el User-Agent de los conectores (SG-05). Solo en .env.local.
INGEST_CONTACT=

# API BCRD (F-02). Token personal del portal apibcrd.bancentral.gov.do; restringido por IP de origen.
BCRD_API_TOKEN=
